# ---- LLM provider -------------------------------------------------------------
# claude_cli (default) | codex_cli | anthropic_api | openai_api | nvidia | local_mlx | openai_compat
# The model picker in the app header saves its choice to data/llm_settings.json, which wins over this file.
LLM_PROVIDER=claude_cli
# Model for the provider named in LLM_PROVIDER (legacy; the per-provider *_MODEL variables below win).
LLM_MODEL=sonnet
# Max parallel LLM calls (the Claude CLI is rate limited; keep small)
LLM_MAX_CONCURRENCY=2
# Cache LLM responses on disk, keyed on the prompt hash (1 = on)
LLM_CACHE=1
LLM_CACHE_PATH=data/cache/llm.sqlite

# claude_cli
CLAUDE_CLI_PATH=claude
# sonnet | opus | haiku (default sonnet)
CLAUDE_CLI_MODEL=

# codex_cli (ChatGPT subscription: npm install -g @openai/codex, then codex login)
CODEX_CLI_PATH=codex
# empty = Codex default
CODEX_MODEL=

# nvidia (free API catalog, OpenAI-compatible) — get a key at build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# local_mlx (Apple Silicon, runs in-process, no key)
MLX_MODEL=mlx-community/Qwen2.5-14B-Instruct-4bit
MLX_SMALL_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit

# anthropic_api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# openai_api (the OpenAI platform, pay per use)
OPENAI_API_KEY=
OPENAI_MODEL=

# openai_compat (any OpenAI-compatible server, e.g. llama-server, vLLM)
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---- Embeddings / retrieval (always local) -------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_HOME=data/models
INDEX_DIR=data/index

# ---- App ----------------------------------------------------------------------
API_PORT=8101
FRONTEND_PORT=3101
NEXT_PUBLIC_API_URL=http://localhost:8101
CORS_ORIGINS=http://localhost:3101
